(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Sweep the classic blue mug off the table)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    classic_blue_mug_1 - classic_blue_mug
  )

  (:obj_of_interest
    classic_blue_mug_1
  )

  (:init
    (On classic_blue_mug_1 main_table_spot_0_region)
  )

  (:goal
    (And (On classic_blue_mug_1 main_table_spot_0_region))
  )

)
