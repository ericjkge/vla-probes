(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pour the water in the classic blue mug onto the black book)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_1_region
          (:target main_table)
          (:ranges (
              (0.290 -0.010 0.310 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_2_region
          (:target main_table)
          (:ranges (
              (0.290 0.390 0.310 0.410)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    black_book_1 - black_book
    akita_black_bowl_1 - akita_black_bowl
    classic_blue_mug_1 - classic_blue_mug
    water_ball_1 water_ball_2 water_ball_3 water_ball_4 - water_ball
  )

  (:obj_of_interest
    black_book_1
  )

  (:init
    (On black_book_1 main_table_spot_0_region)
    (On akita_black_bowl_1 main_table_spot_1_region)
    (On classic_blue_mug_1 main_table_spot_2_region)
    (On water_ball_1 classic_blue_mug_1)
    (On water_ball_2 water_ball_1)
    (On water_ball_3 water_ball_2)
    (On water_ball_4 water_ball_3)
  )

  (:goal
    (And (On black_book_1 main_table_spot_0_region))
  )

)
