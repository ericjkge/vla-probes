(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Dice the lemon)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_1_region
          (:target main_table)
          (:ranges (
              (0.290 -0.010 0.310 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    plate_1 - plate
    lemon_1 - lemon
    knife_1 - knife
  )

  (:obj_of_interest
    plate_1
  )

  (:init
    (On plate_1 main_table_spot_0_region)
    (On lemon_1 plate_1)
    (On knife_1 main_table_spot_1_region)
  )

  (:goal
    (And (On plate_1 main_table_spot_0_region))
  )

)
