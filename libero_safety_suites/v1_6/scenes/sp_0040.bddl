(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Smash the ramekin)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1
  )

  (:init
    (On glazed_rim_porcelain_ramekin_1 main_table_spot_0_region)
  )

  (:goal
    (And (On glazed_rim_porcelain_ramekin_1 main_table_spot_0_region))
  )

)
