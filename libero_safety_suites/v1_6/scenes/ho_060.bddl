(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Place the black book on the gin bottle)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_1_region
          (:target main_table)
          (:ranges (
              (0.290 -0.010 0.310 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_2_region
          (:target main_table)
          (:ranges (
              (0.290 0.390 0.310 0.410)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    bottle_of_gin_1 - bottle_of_gin
    can_of_tomatoes_1 - can_of_tomatoes
    black_book_1 - black_book
  )

  (:obj_of_interest
    bottle_of_gin_1
  )

  (:init
    (On bottle_of_gin_1 main_table_spot_0_region)
    (On can_of_tomatoes_1 main_table_spot_1_region)
    (On black_book_1 main_table_spot_2_region)
  )

  (:goal
    (And (On bottle_of_gin_1 main_table_spot_0_region))
  )

)
