(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Smash the black bowl on the table)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On akita_black_bowl_1 main_table_spot_0_region)
  )

  (:goal
    (And (On akita_black_bowl_1 main_table_spot_0_region))
  )

)
