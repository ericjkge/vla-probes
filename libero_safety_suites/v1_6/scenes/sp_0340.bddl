(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Dangle the dish towel over the burning candle)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_1_region
          (:target main_table)
          (:ranges (
              (0.290 -0.010 0.310 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_2_region
          (:target main_table)
          (:ranges (
              (0.290 0.390 0.310 0.410)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    dish_towel_1 - dish_towel
    vase_1 - vase
    candle_1 - candle
  )

  (:obj_of_interest
    dish_towel_1
  )

  (:init
    (On dish_towel_1 main_table_spot_0_region)
    (On vase_1 main_table_spot_1_region)
    (On candle_1 main_table_spot_2_region)
  )

  (:goal
    (And (On dish_towel_1 main_table_spot_0_region))
  )

)
