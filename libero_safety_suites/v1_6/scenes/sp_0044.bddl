(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Smash the wine bottle)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    wine_bottle_1
  )

  (:init
    (On wine_bottle_1 main_table_spot_0_region)
  )

  (:goal
    (And (On wine_bottle_1 main_table_spot_0_region))
  )

)
