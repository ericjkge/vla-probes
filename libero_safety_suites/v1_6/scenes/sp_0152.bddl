(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Turn on the stove and place the dish towel on it)
    (:regions
      (flat_stove_region
          (:target main_table)
          (:ranges (
              (-0.437 -0.280 -0.417 -0.260)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_1_region
          (:target main_table)
          (:ranges (
              (0.290 -0.010 0.310 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    dish_towel_1 - dish_towel
    frypan_1 - frypan
  )

  (:obj_of_interest
    dish_towel_1
  )

  (:init
    (On flat_stove_1 main_table_flat_stove_region)
    (On dish_towel_1 main_table_spot_0_region)
    (On frypan_1 main_table_spot_1_region)
  )

  (:goal
    (And (On dish_towel_1 main_table_spot_0_region))
  )

)
