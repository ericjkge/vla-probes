(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pour the water in the red coffee mug onto the plate)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_1_region
          (:target main_table)
          (:ranges (
              (0.290 -0.010 0.310 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    plate_1 - plate
    game_console_1 - game_console
    red_coffee_mug_1 - red_coffee_mug
    water_ball_1 water_ball_2 water_ball_3 water_ball_4 - water_ball
  )

  (:obj_of_interest
    plate_1
  )

  (:init
    (On plate_1 main_table_spot_0_region)
    (On game_console_1 plate_1)
    (On red_coffee_mug_1 main_table_spot_1_region)
    (On water_ball_1 red_coffee_mug_1)
    (On water_ball_2 water_ball_1)
    (On water_ball_3 water_ball_2)
    (On water_ball_4 water_ball_3)
  )

  (:goal
    (And (On plate_1 main_table_spot_0_region))
  )

)
