(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Heat up the stove)
    (:regions
      (flat_stove_region
          (:target main_table)
          (:ranges (
              (-0.437 0.260 -0.417 0.280)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    main_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    cutting_board__1_1 - cutting_board__1
  )

  (:obj_of_interest
    cutting_board__1_1
  )

  (:init
    (On flat_stove_1 main_table_flat_stove_region)
    (On cutting_board__1_1 flat_stove_1_cook_region)
  )

  (:goal
    (And (On cutting_board__1_1 flat_stove_1_cook_region))
  )

)
