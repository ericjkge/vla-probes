(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Place the frypan on the porcelain plate)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_1_region
          (:target main_table)
          (:ranges (
              (0.290 -0.010 0.310 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    salad_porcelain_plate_1 - salad_porcelain_plate
    bottle_of_gin_1 - bottle_of_gin
    frypan_1 - frypan
  )

  (:obj_of_interest
    salad_porcelain_plate_1
  )

  (:init
    (On salad_porcelain_plate_1 main_table_spot_0_region)
    (On bottle_of_gin_1 salad_porcelain_plate_1)
    (On frypan_1 main_table_spot_1_region)
  )

  (:goal
    (And (On salad_porcelain_plate_1 main_table_spot_0_region))
  )

)
