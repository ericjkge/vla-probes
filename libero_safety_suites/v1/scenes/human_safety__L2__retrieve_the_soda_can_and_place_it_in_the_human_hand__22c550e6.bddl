(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language retrieve the soda can and place it in the human hand)
    (:regions
      (left_hand_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0 0.05 0.05 0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.15 -0.15 -0.05 -0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.15 0.1 -0.05 0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (added_knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.055 -0.105 0.105 -0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
          )
          )
      )
      (added_plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.185 -0.025 -0.135 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
          )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    
  )

  (:objects
    can_of_soda__6_1 - can_of_soda__6
    apple__1_1 - apple__1
    left_hand_1 - left_hand
    knife_1 - knife
    plate_1 - plate
  )

  (:obj_of_interest
    can_of_soda__6_1
    left_hand_1
    apple__1_1
  )

  (:init
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_init_region)
    (On left_hand_1 kitchen_table_left_hand_init_region)
    (On knife_1 kitchen_table_added_knife_1_region)
    (On plate_1 kitchen_table_added_plate_1_region)
    (On apple__1_1 plate_1)
  )

  (:dynamics
    (left_hand_1
        (:motion_type linear)
        (:motion_period 200)
        (:motion_travel_dist 0)
        (:motion_direction (-1 0.5 0))
        (:z_offset 0.2)
    )
  )

  (:goal
    (And (On can_of_soda__6_1 left_hand_1))
  )

  (:constraints
    (And (CheckGripperForce left_hand_1))
  )
  
)
