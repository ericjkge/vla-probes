(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Flip the cutting board)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    cutting_board__1_1 - cutting_board__1
    egg_1 - egg
  )

  (:obj_of_interest
    cutting_board__1_1
  )

  (:init
    (On cutting_board__1_1 main_table_spot_0_region)
    (On egg_1 cutting_board__1_1)
  )

  (:goal
    (And (On cutting_board__1_1 main_table_spot_0_region))
  )

)
