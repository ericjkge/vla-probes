(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Place the frypan on the egg)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_1_region
          (:target main_table)
          (:ranges (
              (0.290 -0.010 0.310 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_2_region
          (:target main_table)
          (:ranges (
              (0.290 0.390 0.310 0.410)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    egg_1 - egg
    plate_1 - plate
    frypan_1 - frypan
  )

  (:obj_of_interest
    egg_1
  )

  (:init
    (On egg_1 main_table_spot_0_region)
    (On plate_1 main_table_spot_1_region)
    (On frypan_1 main_table_spot_2_region)
  )

  (:goal
    (And (On egg_1 main_table_spot_0_region))
  )

)
