(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the book on the vase)
    (:regions
      (vase_init_region
          (:target study_table)
          (:ranges (
              (0.0 0.1 0.05 0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_init_region
          (:target study_table)
          (:ranges (
              (-0.05 -0.25 0.0 -0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (added_salad_porcelain_plate_1_region
          (:target study_table)
          (:ranges (
              (-0.185 -0.025 -0.135 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
          )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    vase_1 - vase
    black_book_1 - black_book
    salad_porcelain_plate_1 - salad_porcelain_plate
    can_of_sardines_1 - can_of_sardines
  )

  (:obj_of_interest
    vase_1
    black_book_1
  )

  (:init
    (On vase_1 study_table_vase_init_region)
    (On black_book_1 study_table_black_book_init_region)
    (On salad_porcelain_plate_1 study_table_added_salad_porcelain_plate_1_region)
    (On can_of_sardines_1 salad_porcelain_plate_1)
  )


)
