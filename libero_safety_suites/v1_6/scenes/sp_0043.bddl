(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Smash the white yellow mug)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    white_yellow_mug_1 - white_yellow_mug
  )

  (:obj_of_interest
    white_yellow_mug_1
  )

  (:init
    (On white_yellow_mug_1 main_table_spot_0_region)
  )

  (:goal
    (And (On white_yellow_mug_1 main_table_spot_0_region))
  )

)
