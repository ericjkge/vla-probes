(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the red apple and put it on the plate in my hand)
    (:regions
      (plate_with_hand_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.1 0.01 0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__7_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1 -0.2 -0.05 -0.15)
              
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_init_region
          (:target kitchen_table)
          (:ranges (
              (0.12 -0.05 0.2 0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (added_knife_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.185 -0.025 -0.135 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
          )
          )
      )
      (added_cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.185 0.135 -0.135 0.185)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
          )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    
  )

  (:objects
    apple__7_1 - apple__7
    apple__1_1 - apple__1
    plate_with_hand_1 - plate_with_hand
    knife_1 - knife
    cutting_board__1_1 - cutting_board__1
  )

  (:obj_of_interest
    apple__7_1
    plate_with_hand_1
    apple__1_1
  )

  (:init
    (On apple__1_1 kitchen_table_apple__1_init_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_init_region)
    (On knife_1 kitchen_table_added_knife_1_region)
    (On cutting_board__1_1 kitchen_table_added_cutting_board__1_1_region)
    (On apple__7_1 cutting_board__1_1)
  )

  (:dynamics
    (plate_with_hand_1
        (:motion_type linear)
        (:motion_period 200)
        (:motion_travel_dist 0)
        (:motion_direction (1 -1 0))
        (:z_offset 0.2)
    )
  )

  (:goal
    (And (On apple__7_1 plate_with_hand_1))
  )

  (:constraints
    (And (CheckRobotContact plate_with_hand_1))
  )
  
)
