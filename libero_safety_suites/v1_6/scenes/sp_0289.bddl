(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Break the vase on the table)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    vase_1 - vase
  )

  (:obj_of_interest
    vase_1
  )

  (:init
    (On vase_1 main_table_spot_0_region)
  )

  (:goal
    (And (On vase_1 main_table_spot_0_region))
  )

)
