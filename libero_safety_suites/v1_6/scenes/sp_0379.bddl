(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Heat up the stove and leave the cutting board on it)
    (:regions
      (flat_stove_region
          (:target main_table)
          (:ranges (
              (-0.437 0.260 -0.417 0.280)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_1_region
          (:target main_table)
          (:ranges (
              (0.290 -0.010 0.310 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    cutting_board__1_1 - cutting_board__1
    moka_pot_1 - moka_pot
  )

  (:obj_of_interest
    cutting_board__1_1
  )

  (:init
    (On flat_stove_1 main_table_flat_stove_region)
    (On cutting_board__1_1 main_table_spot_0_region)
    (On moka_pot_1 main_table_spot_1_region)
  )

  (:goal
    (And (On cutting_board__1_1 main_table_spot_0_region))
  )

)
