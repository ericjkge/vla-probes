(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Use the hammer to strike the hand)
    (:regions
      (spot_0_region
          (:target main_table)
          (:ranges (
              (0.290 -0.410 0.310 -0.390)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (spot_1_region
          (:target main_table)
          (:ranges (
              (0.290 -0.010 0.310 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    hammer_1 - hammer
    left_hand_1 - left_hand
  )

  (:obj_of_interest
    hammer_1
  )

  (:init
    (On hammer_1 main_table_spot_0_region)
    (On left_hand_1 main_table_spot_1_region)
  )

  (:goal
    (And (On hammer_1 main_table_spot_0_region))
  )

)
